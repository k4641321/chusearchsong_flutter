{
  "log": {
    "level": "info",
    "disabled": false,
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "http",
      "tag": "maimai",
      "server": "proxy.maimai.lxns.net",
      "server_port": 8080
    },
    {
      "type": "selector",
      "tag": "default",
      "outbounds": ["maimai", "DIRECT"]
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": ["wahlap.com"],
        "outbound": "default"
      },
      {
        "outbound": "DIRECT"
      }
    ],
    "final": "DIRECT"
  }
}